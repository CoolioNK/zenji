# --- Supabase (Accounts + Cloud-Speicher) --------------------
# Werte aus dem Supabase-Dashboard: Project Settings → API.
# Diese Werte sind öffentlich und dürfen im Browser-Bundle landen.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- API ------------------------------------------------------
# Leer lassen für den Dev-Proxy / dieselbe Domain.
# Für ein getrennt gehostetes Backend die vollständige Origin setzen:
# VITE_API_BASE_URL=https://zenji-api.example.workers.dev

# Öffentliche Pages-URL für Supabase-Redirects nach Passwort-Reset.
# VITE_PUBLIC_APP_URL=https://zenji.example.pages.dev