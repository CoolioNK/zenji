# ============================================================
# ZENJI – Konfiguration (Beispieldatei)
# Kopieren nach backend/.env und bei Bedarf anpassen.
# Alle Werte sind optional; fehlende Zeilen nutzen die Defaults.
# ============================================================

# --- Speicher: externe SSD als Hauptspeicher -----------------
# Wurzel der externen SSD (Standard: /Volumes/ZENJI-SSD)
ZENJI_SSD_ROOT=/Volumes/ZENJI-SSD

# Optionale Overrides (sonst automatisch abgeleitet):
# ZENJI_STORAGE_DIR=/Volumes/ZENJI-SSD/ZENJI
# ZENJI_DB_PATH=/Volumes/ZENJI-SSD/ZENJI/data/zenji.db
# ZENJI_LOG_DIR=/Volumes/ZENJI-SSD/logs

ZENJI_LOG_LEVEL=INFO

# --- Allgemeine ZENJI-Parameter (Laufzeit auch per PATCH /api/settings) ---
ZENJI_LLM__PROVIDER=ollama
ZENJI_LLM__MODEL=qwen3:8b
ZENJI_LLM__TEMPERATURE=0.7
ZENJI_LLM__TOP_P=0.9
ZENJI_LLM__TOP_K=20
ZENJI_LLM__REPEAT_PENALTY=1.05
ZENJI_LLM__NUM_PREDICT=2048
ZENJI_LLM__NUM_CTX=8192
ZENJI_LLM__STREAM=true

# --- Provider-spezifisch: Ollama ------------------------------
ZENJI_OLLAMA_BASE_URL=http://localhost:11434
# ZENJI_OLLAMA__TIMEOUT=120
# ZENJI_OLLAMA__CONNECT_TIMEOUT=5
# ZENJI_OLLAMA__KEEP_ALIVE=10m
# ZENJI_OLLAMA__THINK=false
# ZENJI_OLLAMA__STRIP_THINK=true

# --- Provider-spezifisch: Cloudflare Workers AI ---------------
# Kostenloses KI-Modell in der Cloudflare-Cloud (Free-Plan: täglich
# 10.000 Neuronen). Aktivierung:
#   1) ZENJI_LLM__PROVIDER=cloudflare
#   2) ZENJI_LLM__MODEL=@cf/…   (Modell aus dem Cloudflare-Katalog)
#   3) Konto-ID + API-Token eintragen (beide nötig):
#      Konto-ID: Cloudflare-Dashboard → Übersicht → rechts „Account ID"
#      Token:    My Profile → API Tokens → Create Token
#                (Berechtigung: Account → Workers AI → Run/Edit)
ZENJI_CLOUDFLARE_ACCOUNT_ID=
ZENJI_CLOUDFLARE_API_TOKEN=
# ZENJI_CLOUDFLARE__TIMEOUT=120
# ZENJI_CLOUDFLARE__CONNECT_TIMEOUT=5
# ZENJI_CLOUDFLARE__STRIP_THINK=true
#
# Modellbeispiele (mit @cf-Präfix, Auswahl per GET /api/models):
#   @cf/meta/llama-3.1-8b-instruct-fast        – sparsam, ideal für Free-Plan
#   @cf/meta/llama-3.3-70b-instruct-fp8-fast   – stärker, verbraucht mehr Neuronen
#   @cf/qwen/qwen2.5-coder-32b-instruct        – Code-fokussiert
# ZENJI_LLM__MODEL=@cf/meta/llama-3.1-8b-instruct-fast

# --- CORS ------------------------------------------------------
# Origins, die auf die API zugreifen dürfen (Komma-getrennt).
ZENJI_CORS_ORIGINS=http://localhost:5173
# Öffentliche Frontend-Origin (z. B. Cloudflare Pages). Wird zusätzlich
# zu ZENJI_CORS_ORIGINS erlaubt.
ZENJI_PUBLIC_BASE_URL=

# --- Supabase (Accounts + Cloud-Speicher) --------------------
# Sobald URL, Anon-Key und DB-URL gesetzt sind, läuft ZENJI ausschließlich
# gegen Supabase: Login über Supabase Auth, alle Nutzerdaten in Supabase
# Postgres, getrennt durch Row-Level-Security.
# Werte im Supabase-Dashboard: Project Settings → API / Database → Connect.
# Neue Schlüsselfelder heißen "Publishable" (sb_publishable_…) bzw. "Secret"
# (sb_secret_…); die alten JWT-basierten anon/service_role-Keys funktionieren
# weiterhin.
ZENJI_SUPABASE_URL=
ZENJI_SUPABASE_ANON_KEY=
ZENJI_SUPABASE_SERVICE_ROLE_KEY=
ZENJI_SUPABASE_DB_URL=
ZENJI_SUPABASE_JWT_SECRET=

# --- Persönlichkeit (optional; sonst eingebauter ZENJI-Default) ---
# ZENJI_PERSONA_SYSTEM_PROMPT=Du bist ZENJI ...

# ============================================================
# WICHTIG (nur für den Ollama-Prozess, nicht für das Backend):
# Modellgewichte auf der externen SSD ablegen:
#   OLLAMA_MODELS=/Volumes/ZENJI-SSD/models
# start.sh setzt diese Variable automatisch.
# ============================================================
